+  } pipe_classes;
+  static uint64_t PairKey(uint64_t vs_hash, uint64_t ps_hash, bool gs) {
+    return vs_hash * 0x9E3779B97F4A7C15ull ^ ps_hash ^ (gs ? 0x5555ull : 0);
+  }
+  int ClassifyPipeline(uint64_t vs_hash, uint64_t ps_hash, bool gs, uint32_t spec) {
+    auto& c = pipe_classes;
+    const uint64_t pair = PairKey(vs_hash, ps_hash, gs);
+    if (!c.ps.count(ps_hash)) return 0;
+    if (!c.pair.count(pair)) return 1;
+    if (!c.pair_spec.count(pair ^ (uint64_t(spec) << 1))) {
+      for (uint32_t other : {spec ^ kSpecScaled})
+        if (c.pair_spec.count(pair ^ (uint64_t(other) << 1))) return 2;
+      return 3;
+    }
+    return 4;
+  }
