+    auto& c = pipe_classes;
+    const uint64_t pair = PairKey(vs_hash, ps_hash, gs);
+    c.ps.insert(ps_hash);
+    c.pair.insert(pair);
+    c.pair_spec.insert(pair ^ (uint64_t(spec) << 1));
+  }
+  void CountPipeline(int cls, double ms) {
+    auto& c = pipe_classes;
