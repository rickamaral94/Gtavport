+  // Gtavport (--gtav_native_early_tests): the game pixel shader with OpExecutionMode EarlyFragmentTests
+  // added after its entry point (not for the tile override variant, nor shaders that write depth).
+  std::unordered_map<uint64_t, std::unique_ptr<RenderShader>> early_shaders;
+  RenderShader* EarlyShader(uint64_t hash) {
+    if (TileOverride(hash)) return nullptr;
+    if (auto it = early_shaders.find(hash); it != early_shaders.end()) return it->second.get();
+    std::string dir = REXCVAR_GET(gtav_native_spirv_dir);
+    if (dir.empty()) dir = DefaultSpirvDir();
+    std::vector<uint32_t> words;
+    if (FILE* f = std::fopen(fmt::format("{}/ps_{:016X}.spv", dir, hash).c_str(), "rb")) {
+      std::fseek(f, 0, SEEK_END);
+      long size = std::ftell(f);
+      std::fseek(f, 0, SEEK_SET);
+      if (size > 20 && size % 4 == 0) {
+        words.resize(size_t(size) / 4);
+        if (std::fread(words.data(), 4, words.size(), f) != words.size()) words.clear();
+      }
+      std::fclose(f);
+    }
+    std::unique_ptr<RenderShader> shader;
+    std::vector<uint32_t> out;
+    if (AddEarlyFragmentTests(words, &out))
+      shader = device->createShader(out.data(), out.size() * 4, "main", RenderShaderFormat::SPIRV);
+    return (early_shaders[hash] = std::move(shader)).get();
+  }
+  // SPIR-V: OpExecutionMode %entry EarlyFragmentTests after the last OpEntryPoint. False when the module
+  // is not a fragment shader, already has it, or writes depth (BuiltIn FragDepth / DepthReplacing).
+  static bool AddEarlyFragmentTests(const std::vector<uint32_t>& in, std::vector<uint32_t>* out) {
+    constexpr uint32_t kOpEntryPoint = 15, kOpExecutionMode = 16, kOpDecorate = 71;
+    constexpr uint32_t kFragment = 4, kEarly = 9, kDepthReplacing = 12, kBuiltIn = 11, kFragDepth = 22;
+    if (in.size() < 5 || in[0] != 0x07230203u) return false;
+    size_t insert_at = 0;
+    uint32_t entry = 0;
+    for (size_t i = 5; i < in.size();) {
+      const uint32_t count = in[i] >> 16, op = in[i] & 0xFFFF;
+      if (count == 0 || i + count > in.size()) return false;
+      if (op == kOpEntryPoint && count >= 3 && in[i + 1] == kFragment) {
+        entry = in[i + 2];
+        insert_at = i + count;
+      }
+      if (op == kOpExecutionMode && count >= 3 && (in[i + 2] == kEarly || in[i + 2] == kDepthReplacing)) return false;
+      if (op == kOpDecorate && count >= 4 && in[i + 2] == kBuiltIn && in[i + 3] == kFragDepth) return false;
+      i += count;
+    }
+    if (!entry) return false;
+    out->assign(in.begin(), in.begin() + long(insert_at));
+    out->insert(out->end(), {(3u << 16) | kOpExecutionMode, entry, kEarly});
+    out->insert(out->end(), in.begin() + long(insert_at), in.end());
+    return true;
+  }
