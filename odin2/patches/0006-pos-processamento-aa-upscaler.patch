+uint32_t Backend::PostProcess(RenderCommandList* list, uint32_t front_descriptor, uint32_t out_w, uint32_t out_h) {
+  auto& s = *impl_;
+  if (!s.post) {
+    PostHost h;
+    h.device = s.device;
+    h.textures = s.texture_set.get();
+    h.samplers = s.sampler_set.get();
+    h.texture_heap_size = kTextureDescriptors;
+    h.sampler_heap_size = kSamplerDescriptors;
+    h.alloc_descriptor = [&s] { return s.AllocDescriptor(); };
+    h.sampler = [&s](const RenderSamplerDesc& d) { return s.Sampler(d); };
+    h.invalidate_draw_state = [&s] { s.InvalidateDrawState(); };
+    s.post = std::make_unique<Post>(std::move(h));
+  }
+  return s.post->Run(list, front_descriptor, s.present_w, s.present_h, out_w, out_h);
+}
