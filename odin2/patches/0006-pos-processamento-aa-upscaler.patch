+// Gtavport (odin2/post): anti-aliasing, upscaler e resolução interna, como no BOTWRecompAndroid.
+// AA e upscaler valem na hora; a resolução interna é lida no início (vale no próximo início do jogo).
+void BuildVideo(bool& changed) {
+  ImGui::TextUnformatted("Video");
+  auto combo = [&](const char* label, const char* cvar, const char* const* values, const char* const* names, int n,
+                   const char* help) {
+    std::string cur = rex::cvar::GetFlagByName(cvar);
+    int choice = 0;
+    for (int i = 0; i < n; i++)
+      if (cur == values[i]) choice = i;
+    ImGui::SetNextItemWidth(260.0f * g_scale);
+    if (ImGui::Combo(label, &choice, names, n)) {
+      rex::cvar::SetFlagByName(cvar, values[choice]);
+      changed = true;
+    }
+    if (help && ImGui::IsItemHovered()) ImGui::SetTooltip("%s", help);
+  };
+  static const char* const kAaValues[] = {"off", "fxaa", "smaa"};
+  static const char* const kAaNames[] = {"Off", "FXAA", "SMAA 1x"};
+  combo("Anti-aliasing", "odin2_antialias", kAaValues, kAaNames, 3,
+        "Smooths jagged edges of the game image (HUD included).\n"
+        "FXAA: one cheap pass, slightly soft. SMAA 1x: three passes, sharper edges, costs more GPU.");
+  static const char* const kUpValues[] = {"bilinear", "fsr1", "sgsr1"};
+  static const char* const kUpNames[] = {"Bilinear (original)", "AMD FSR 1 (EASU + RCAS)",
+                                         "Snapdragon GSR 1 (edge direction)"};
+  combo("Upscaler", "odin2_upscaler", kUpValues, kUpNames, 3,
+        "How the game image is enlarged to the screen (720p and below -> the display).\n"
+        "Snapdragon GSR 1: one pass, made for Adreno. FSR 1: two passes, a bit sharper and costlier.");
+  if (rex::cvar::GetFlagByName("odin2_upscaler") == "fsr1") {
+    float sharp = float(std::atof(rex::cvar::GetFlagByName("odin2_fsr_sharpness").c_str()));
+    ImGui::SetNextItemWidth(200.0f * g_scale);
+    if (ImGui::SliderFloat("FSR sharpness (stops, 0 = max)", &sharp, 0.0f, 2.0f, "%.1f")) {
+      rex::cvar::SetFlagByName("odin2_fsr_sharpness", std::to_string(sharp));
+      changed = true;
+    }
+  }
+  static const char* const kScaleValues[] = {"0.5", "0.6", "0.67", "0.75", "0.85", "1"};
+  static const char* const kScaleNames[] = {"50%", "60%", "67%", "75%", "85%", "100% (native 720p)"};
+  std::string scale = rex::cvar::GetFlagByName("gtav_native_render_scale");
+  int choice = -1;
+  for (int i = 0; i < 6; i++)
+    if (std::abs(std::atof(scale.c_str()) - std::atof(kScaleValues[i])) < 0.005) choice = i;
+  const char* custom[7];
+  for (int i = 0; i < 6; i++) custom[i] = kScaleNames[i];
+  custom[6] = "Custom (command line)";
+  if (choice < 0) choice = 6;
+  ImGui::SetNextItemWidth(260.0f * g_scale);
+  if (ImGui::Combo("Internal resolution", &choice, custom, choice == 6 ? 7 : 6) && choice < 6) {
+    rex::cvar::SetFlagByName("gtav_native_render_scale", kScaleValues[choice]);
+    changed = true;
+  }
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Share of 1280x720 the 3D scene is drawn at. Lower: faster, softer (pair it with an upscaler).\n"
+                      "Applies the next time the game starts.");
+  ImGui::TextDisabled("Internal resolution applies on the next start; the others right away.");
+}
