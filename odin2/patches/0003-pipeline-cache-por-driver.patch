+  // Gtavport: um arquivo por driver (ODIN2_VK_DRIVER), para a matriz A/B/BA de drivers não
+  // invalidar o cache um do outro. Driver do sistema: o nome original.
+  std::filesystem::path PipelineCachePath() {
+    const char* driver = std::getenv("ODIN2_VK_DRIVER");
+    if (!driver || !*driver || std::string_view(driver) == "system")
+      return ExeDir() / "shader_cache" / "vk_pipelines.bin";
+    std::string safe;
+    for (const char* p = driver; *p; ++p) safe += std::isalnum(static_cast<unsigned char>(*p)) || *p == '.' || *p == '-' ? *p : '_';
+    return ExeDir() / "shader_cache" / ("vk_pipelines." + safe + ".bin");
+  }
 
