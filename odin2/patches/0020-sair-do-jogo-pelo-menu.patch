 #include <imgui.h>
 #include <rex/cvar.h>
 #include <rex/logging.h>
@@ -237,6 +241,67 @@ ImGuiKey ToImGui(Key key) {
   return ImGuiKey_None;
 }
 
+// Gtavport: sair do jogo pelo menu (o Voltar do Android abre este menu), como a aba Sair do BOTW/TOTK.
+// Java Odin2Exit.quit(activity, toMenu): o processo do jogo (":game") termina e o menu inicial do app
+// volta (ou o app fecha). Pela class loader da Activity: FindClass numa thread do jogo não acha as
+// classes do app.
+#ifdef __ANDROID__
+bool QuitGame(bool to_menu) {
+  auto* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+  auto activity = static_cast<jobject>(SDL_GetAndroidActivity());
+  if (!env || !activity) return false;
+  bool ok = false;
+  jclass act_cls = env->GetObjectClass(activity);
+  jmethodID get_loader = env->GetMethodID(act_cls, "getClassLoader", "()Ljava/lang/ClassLoader;");
+  jobject loader = get_loader ? env->CallObjectMethod(activity, get_loader) : nullptr;
+  if (loader) {
+    jclass loader_cls = env->GetObjectClass(loader);
+    jmethodID load = env->GetMethodID(loader_cls, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;");
+    jstring name = env->NewStringUTF("com.gtavrecomp.app.Odin2Exit");
+    auto exit_cls = load ? static_cast<jclass>(env->CallObjectMethod(loader, load, name)) : nullptr;
+    if (exit_cls && !env->ExceptionCheck()) {
+      jmethodID quit = env->GetStaticMethodID(exit_cls, "quit", "(Landroid/app/Activity;Z)V");
+      if (quit) {
+        env->CallStaticVoidMethod(exit_cls, quit, activity, jboolean(to_menu));
+        ok = !env->ExceptionCheck();
+      }
+    }
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    if (exit_cls) env->DeleteLocalRef(exit_cls);
+    env->DeleteLocalRef(name);
+    env->DeleteLocalRef(loader_cls);
+    env->DeleteLocalRef(loader);
+  }
+  if (env->ExceptionCheck()) env->ExceptionClear();
+  env->DeleteLocalRef(act_cls);
+  env->DeleteLocalRef(activity);
+  REXLOG_INFO("[native] sair do jogo ({}): {}", to_menu ? "menu inicial" : "fechar o app", ok ? "ok" : "falhou");
+  return ok;
+}
+
+int g_quit_ask = 0;  // 0 nada; 1 voltar ao menu inicial?; 2 fechar o app?
+
+void BuildQuit() {
+  ImGui::TextUnformatted("Sair do jogo");
+  if (g_quit_ask == 0) {
+    if (ImGui::Button("Voltar ao menu inicial")) g_quit_ask = 1;
+    ImGui::SameLine();
+    if (ImGui::Button("Fechar o app")) g_quit_ask = 2;
+    ImGui::TextDisabled("Voltar (Android) ou Start abre e fecha este menu.");
+    return;
+  }
+  ImGui::TextColored(ImVec4(1.0f, 0.8f, 0.3f, 1.0f), "%s",
+                     g_quit_ask == 1 ? "Voltar ao menu inicial do Gtavport?" : "Fechar o Gtavport?");
+  ImGui::TextWrapped("O progresso desde o último save do jogo se perde. As configurações ficam salvas.");
+  if (ImGui::Button(g_quit_ask == 1 ? "Sim, voltar ao menu" : "Sim, fechar")) {
+    SaveSettings();
+    if (!QuitGame(g_quit_ask == 1)) g_quit_ask = 0;
+  }
+  ImGui::SameLine();
+  if (ImGui::Button("Cancelar")) g_quit_ask = 0;
+}
+#endif
+
 void Build(uint32_t fps, double frame_ms) {
 #if defined(__APPLE__) && TARGET_OS_IPHONE
   // Centred: the screen's sides are under the rounded corners and the notch.
