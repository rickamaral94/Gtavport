+    // Gtavport: the driver's compiler statistics (and text IR when withIR) of each executable of a
+    // graphics pipeline created with GTAVPORT_PIPELINE_STATS=1. Empty when unavailable.
+    std::string GetVulkanPipelineReport(RenderDevice *device, const RenderPipeline *pipeline, bool withIR) {
+        auto *dev = static_cast<VulkanDevice *>(device);
+        auto *gp = static_cast<const VulkanGraphicsPipeline *>(pipeline);
+        if (dev == nullptr || gp == nullptr || !dev->pipelineStatsEnabled || gp->vk == VK_NULL_HANDLE || vkGetPipelineExecutablePropertiesKHR == nullptr) {
+            return {};
+        }
+        VkPipelineInfoKHR info = { VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR };
+        info.pipeline = gp->vk;
+        uint32_t count = 0;
+        if (vkGetPipelineExecutablePropertiesKHR(dev->vk, &info, &count, nullptr) != VK_SUCCESS || count == 0) {
+            return {};
+        }
+        std::vector<VkPipelineExecutablePropertiesKHR> props(count, { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR });
+        vkGetPipelineExecutablePropertiesKHR(dev->vk, &info, &count, props.data());
+        std::string out;
+        char line[512];
+        for (uint32_t i = 0; i < count; i++) {
+            snprintf(line, sizeof(line), "  executável %u: %s (%s), subgroup %u\n", i, props[i].name, props[i].description, props[i].subgroupSize);
+            out += line;
+            VkPipelineExecutableInfoKHR einfo = { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR };
+            einfo.pipeline = gp->vk;
+            einfo.executableIndex = i;
+            uint32_t ns = 0;
+            if (vkGetPipelineExecutableStatisticsKHR != nullptr && vkGetPipelineExecutableStatisticsKHR(dev->vk, &einfo, &ns, nullptr) == VK_SUCCESS && ns > 0) {
+                std::vector<VkPipelineExecutableStatisticKHR> stats(ns, { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR });
+                vkGetPipelineExecutableStatisticsKHR(dev->vk, &einfo, &ns, stats.data());
+                out += "    stats:";
+                for (const VkPipelineExecutableStatisticKHR &s : stats) {
+                    switch (s.format) {
+                    case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR: snprintf(line, sizeof(line), " %s=%s;", s.name, s.value.b32 ? "true" : "false"); break;
+                    case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR: snprintf(line, sizeof(line), " %s=%lld;", s.name, (long long)s.value.i64); break;
+                    case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR: snprintf(line, sizeof(line), " %s=%llu;", s.name, (unsigned long long)s.value.u64); break;
+                    default: snprintf(line, sizeof(line), " %s=%g;", s.name, s.value.f64); break;
+                    }
+                    out += line;
+                }
+                out += "\n";
+            }
+            uint32_t nr = 0;
+            if (withIR && vkGetPipelineExecutableInternalRepresentationsKHR != nullptr &&
+                vkGetPipelineExecutableInternalRepresentationsKHR(dev->vk, &einfo, &nr, nullptr) == VK_SUCCESS && nr > 0) {
+                std::vector<VkPipelineExecutableInternalRepresentationKHR> reps(nr, { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INTERNAL_REPRESENTATION_KHR });
+                vkGetPipelineExecutableInternalRepresentationsKHR(dev->vk, &einfo, &nr, reps.data());
+                std::vector<std::vector<char>> data(nr);
+                for (uint32_t r = 0; r < nr; r++) {
+                    data[r].resize(reps[r].dataSize + 1, 0);
+                    reps[r].pData = data[r].data();
+                }
+                vkGetPipelineExecutableInternalRepresentationsKHR(dev->vk, &einfo, &nr, reps.data());
+                for (uint32_t r = 0; r < nr; r++) {
+                    if (!reps[r].isText) continue;
+                    out += "    --- ";
+                    out += reps[r].name;
+                    out += " ---\n";
+                    out += data[r].data();
+                    out += "\n";
+                }
+            }
+        }
+        return out;
+    }
