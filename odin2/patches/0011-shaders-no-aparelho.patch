+
+// Gtavport: on the phone the tools are in the APK's nativeLibraryDir (the only place Android runs
+// files from) as lib*.so, set by the app (Odin2DeviceBuild.configureRuntime): GTAVPORT_NATIVE_LIB_DIR
+// and GTAVPORT_SHADER_COMMON (XenosRecomp's shader_common.h with the Adreno edits of make_spirv.sh).
+// Then the Adreno passes of the PC's Android build run here too, through shader_fix (the C++ ports of
+// ubo_constants.py and lower_int64.py): XenosRecomp -> ubo -> DXC -> int64, as install.cpp PhoneShaders.
+struct DeviceTools {
+  bool on = false;
+  fs::path xr, dxc, fix, common;
+};
+const DeviceTools& Device() {
+  static const DeviceTools t = [] {
+    DeviceTools d;
+#ifdef __ANDROID__
+    const char* lib = std::getenv("GTAVPORT_NATIVE_LIB_DIR");
+    const char* common = std::getenv("GTAVPORT_SHADER_COMMON");
+    if (lib && *lib && common && *common) {
+      d.xr = fs::path(lib) / "libxenosrecomp.so";
+      d.dxc = fs::path(lib) / "libdxc.so";
+      d.fix = fs::path(lib) / "libshader_fix.so";
+      d.common = common;
+      std::error_code ec;
+      d.on = fs::exists(d.xr, ec) && fs::exists(d.dxc, ec) && fs::exists(d.fix, ec) && fs::exists(d.common, ec);
+      // dxc and XenosRecomp load libdxcompiler.so from the same folder.
+      if (d.on) setenv("LD_LIBRARY_PATH", lib, 1);
+      REXLOG_INFO("[native] on-device shader tools: {}", d.on ? "ready" : "missing (APK without them)");
+    }
+#endif
+    return d;
+  }();
+  return t;
+}
