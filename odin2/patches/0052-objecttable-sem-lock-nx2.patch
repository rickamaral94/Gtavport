 namespace rex::system::util {
 
+// Writer side of the lookup guard (see readers_ in the header). Callers hold table_mutex_.
+// Not reentrant: nothing under it may look up a handle or start another ExclusiveSlots.
+class ObjectTable::ExclusiveSlots {
+ public:
+  explicit ExclusiveSlots(ObjectTable& t) : t_(t) {
+    t_.writer_.store(true, std::memory_order_seq_cst);
+    while (t_.readers_.load(std::memory_order_seq_cst) != 0) std::this_thread::yield();
+  }
+  ~ExclusiveSlots() { t_.writer_.store(false, std::memory_order_release); }
+  ExclusiveSlots(const ExclusiveSlots&) = delete;
+  ExclusiveSlots& operator=(const ExclusiveSlots&) = delete;
+
+ private:
+  ObjectTable& t_;
+};
+
+void ObjectTable::BeginLookup() {
+  for (;;) {
+    readers_.fetch_add(1, std::memory_order_seq_cst);
+    if (!writer_.load(std::memory_order_seq_cst)) return;
+    readers_.fetch_sub(1, std::memory_order_seq_cst);
+    while (writer_.load(std::memory_order_acquire)) std::this_thread::yield();
+  }
+}
+
 ObjectTable::ObjectTable() {}
 
