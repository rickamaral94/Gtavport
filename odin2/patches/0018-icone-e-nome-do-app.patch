--- a/tools/android/build_apk.sh
+++ b/tools/android/build_apk.sh
@@ -40,9 +40,16 @@
 # Gtavport: ODIN2_PACKAGE troca o applicationId (as classes Java continuam com.gtavrecomp.app), para
 # o APK do Gtavport conviver com o do upstream sem conflito de assinatura nem perda de dados.
 # Gtavport: ODIN2_ASSETS = pasta de assets (toolroot da Fase 1).
+# Gtavport: ODIN2_RES = pasta res/ (ícone do app: odin2/android/icon/make_icons.py).
+RES_ARGS=()
+if [ -n "${ODIN2_RES:-}" ]; then
+  rm -f res.zip
+  "$BT/aapt2" compile --dir "$ODIN2_RES" -o res.zip
+  RES_ARGS=(res.zip)
+fi
 "$BT/aapt2" link -o base.apk --manifest "$MANIFEST" -I "$JAR" \
   --min-sdk-version 30 --target-sdk-version 34 ${ODIN2_PACKAGE:+--rename-manifest-package "$ODIN2_PACKAGE"} \
-  ${ODIN2_ASSETS:+-A "$ODIN2_ASSETS"}
+  ${ODIN2_ASSETS:+-A "$ODIN2_ASSETS"} "${RES_ARGS[@]}"
 
 cp "${LIBS[@]}" "$SDK_LIB/librexruntime.so" "$SDK_LIB/librexgpu-xenos.so" \
    "$NDK_LIBCXX" stage/lib/arm64-v8a/
@@ -65,7 +72,7 @@
 "$BT/apksigner" sign --ks "$KEY" --ks-pass pass:android --key-pass pass:android \
   --out $NAME.apk aligned.apk
 fi
-rm -f unaligned.apk aligned.apk base.apk
+rm -f unaligned.apk aligned.apk base.apk res.zip
 ls -la $NAME.apk
 if [ "$1" = install ]; then
   adb install -r $NAME.apk
--- a/tools/android/app/AndroidManifest.xml
+++ b/tools/android/app/AndroidManifest.xml
@@ -18,7 +18,8 @@
     <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
     <uses-permission android:name="android.permission.WAKE_LOCK" />
     <application
-        android:label="GTA V Recomp"
+        android:label="Gtavport"
+        android:icon="@mipmap/ic_launcher"
         android:appCategory="game"
         android:isGame="true"
         android:debuggable="true"
