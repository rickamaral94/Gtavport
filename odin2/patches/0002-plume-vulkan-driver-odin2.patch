+                    odin2Vulkan = open();
+                }
+            }
+            auto gipa = odin2Vulkan ? reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(odin2Vulkan, "vkGetInstanceProcAddr")) : nullptr;
+            if (gipa) {
+                volkInitializeCustom(gipa);
+                res = VK_SUCCESS;
+            } else {
+                res = volkInitialize();
+            }
+        }
 #else
         VkResult res = volkInitialize();
