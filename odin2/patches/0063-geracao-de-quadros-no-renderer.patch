+uint32_t Backend::RegisterTexture(RenderTexture* texture, RenderTextureView* view) {
+  auto& s = *impl_;
+  uint32_t d = s.AllocDescriptor();
+  if (d != kOverflow) s.texture_set->setTexture(d, texture, RenderTextureLayout::GENERAL, view);
+  return d;
+}
+
+void Backend::ReleaseDescriptor(uint32_t descriptor) {
+  if (descriptor && descriptor != kOverflow) impl_->pending_free_descriptors.push_back(descriptor);
+}
+
 void Backend::Blit(RenderCommandList* list, uint32_t descriptor, RenderFormat target_format) {
   impl_->BlitTo(list, descriptor, target_format);
 }
