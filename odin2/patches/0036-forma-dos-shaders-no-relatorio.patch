+std::string ShaderSourceInfo(const std::string& name) {
+  std::ifstream in(CacheDir() / (name + ".hlsl"));
+  if (!in) return "sem HLSL no cache (traduzido na instalação ou ainda não traduzido)";
+  size_t lines = 0, loops = 0, cases = 0;
+  bool dispatch = false;
+  std::string line;
+  while (std::getline(in, line)) {
+    lines++;
+    if (line.find("switch (pc)") != std::string::npos) dispatch = true;
+    if (line.find("for (aL = 0;") != std::string::npos || line.find("++aL;") != std::string::npos) loops++;
+    if (line.find("case ") != std::string::npos && line.find(':') != std::string::npos) cases++;
+  }
+  return fmt::format("HLSL {} linhas | {} | laços {} | cases {}", lines,
+                     dispatch ? "fluxo em máquina de estados (while/switch(pc))" : "fluxo estruturado", loops, cases);
+}
