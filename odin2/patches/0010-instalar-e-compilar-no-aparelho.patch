+// Gtavport (odin2/android Odin2DeviceBuild): the whole install on the phone, no PC (install.cpp
+// RunDeviceBuild). `self` has the same callbacks as SetupActivity (onStage, onLog, onProgress,
+// isCancelled, onAsk). Returns null when done, else the error text.
+JNIEXPORT jstring JNICALL Java_com_gtavrecomp_app_Odin2DeviceBuild_nativeBuild(
+    JNIEnv* env, jobject self, jstring toolroot, jstring libdir, jstring home, jstring private_dir, jstring disc1,
+    jstring disc2, jstring tu) {
+  JavaUi ui(env, self);
+  loader::InstallInputs in{W(env, disc1), W(env, disc2), W(env, tu)};
+  std::wstring error;
+  bool ok = loader::RunDeviceBuild(std::filesystem::path(W(env, toolroot)), std::filesystem::path(W(env, libdir)),
+                                   std::filesystem::path(W(env, home)), std::filesystem::path(W(env, private_dir)),
+                                   in, ui, &error);
+  if (ok) return nullptr;
+  return env->NewStringUTF(N(error.empty() ? std::wstring(L"The build stopped.") : error).c_str());
+}
