index 032fc8f..1da90fc 100644
--- a/gtav/src/native/shader_compiler.cpp
+++ b/gtav/src/native/shader_compiler.cpp
@@ -378,6 +378,18 @@ void ShaderQueueStatus(uint32_t* done, uint32_t* pending) {
   *pending = g_pending.load(std::memory_order_relaxed);
 }
 
+// Gtavport: a draw is missing this shader: to the front of the queue (no wait; WaitForShader is the
+// upstream's blocking version, used when the shader is first looked up).
+void PrioritizeShader(uint64_t hash, bool pixel) {
+  std::string name = fmt::format("{}_{:016X}", pixel ? "ps" : "vs", hash);
+  std::lock_guard lock(g_mutex);
+  if (g_present.count(name)) return;
+  auto it = std::find(g_queue.begin(), g_queue.end(), name);
+  if (it == g_queue.end() || it == g_queue.begin()) return;
+  g_queue.erase(it);
+  g_queue.push_front(std::move(name));
+}
+
 bool ShaderOnDisk(const std::string& name) {
   std::lock_guard lock(g_mutex);
   return g_present.count(name) != 0;
