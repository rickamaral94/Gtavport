+// Gtavport: a reference of our own to SDLActivity's current surface (SDLActivity.getNativeSurface,
+// the way SDL gets it). SDL releases its ANativeWindow when the surface is destroyed but leaves the
+// stale pointer in SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER; rebuilding the swap chain on it crashed
+// in RefBase::incStrong (SIGSEGV at 0x4) after leaving the game and coming back, with any driver.
+// Null when there is no valid surface (in the background).
+static ANativeWindow* AcquireSdlSurface() {
+  auto* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+  auto activity = static_cast<jobject>(SDL_GetAndroidActivity());
+  if (!env || !activity) return nullptr;
+  ANativeWindow* window = nullptr;
+  jclass cls = env->GetObjectClass(activity);
+  jmethodID mid = env->GetStaticMethodID(cls, "getNativeSurface", "()Landroid/view/Surface;");
+  if (mid) {
+    if (jobject surface = env->CallStaticObjectMethod(cls, mid)) {
+      window = ANativeWindow_fromSurface(env, surface);
+      env->DeleteLocalRef(surface);
+    }
+  }
+  if (env->ExceptionCheck()) env->ExceptionClear();
+  env->DeleteLocalRef(cls);
+  env->DeleteLocalRef(activity);
+  return window;
+}
